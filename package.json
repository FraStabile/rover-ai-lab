{
  "name": "rover-ai-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:jev": "concurrently -k -n jev,server,web -c yellow,cyan,magenta \"npm:jev\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @rover/server",
    "dev:web": "npm run dev -w @rover/web",
    "build": "npm run typecheck && npm run build -w @rover/web",
    "start": "npm run start -w @rover/server",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-jev": "tsx scripts/mock-jev-server.ts",
    "jev": "bash scripts/run-jev.sh",
    "jev:install": "bash scripts/install-jev.sh",
    "compare": "tsx scripts/compare-engines.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build -w @rover/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
