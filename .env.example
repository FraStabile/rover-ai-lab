# Server
# Development: Vite serves the UI on :3000 and proxies /api + /ws to the API on API_PORT.
API_PORT=3001
# Production (npm start / docker): one process serves UI + API on PORT.
PORT=3000
HOST=0.0.0.0

# Database (SQLite file)
DATABASE_URL=file:./data/rover.db

# Simulation
SIMULATION_DEFAULT_HZ=50
SIMULATION_SEED=12345

# AI provider: mock | local-jev | custom-http
AI_PROVIDER=mock
JEV_ENABLED=false
JEV_BASE_URL=http://localhost:8000
JEV_MODEL=default
JEV_TIMEOUT=1000
# native | openai-chat
JEV_PROTOCOL=native
JEV_DECIDE_PATH=/decide
JEV_HEALTH_PATH=/health
