# Server
# Development: Vite serves the UI on :3000 and proxies /api + /ws to the API on API_PORT.
API_PORT=3001
# Production (npm start / docker): one process serves UI + API on PORT.
PORT=3000
HOST=0.0.0.0

# Database (SQLite file)
DATABASE_URL=file:./data/rover.db

# Simulation
SIMULATION_DEFAULT_HZ=50
SIMULATION_SEED=12345

# AI provider: mock | local-jev | custom-http
AI_PROVIDER=mock
JEV_ENABLED=false
# jevos (npm run jev / npm run mock-jev) listens on 8017
JEV_BASE_URL=http://127.0.0.1:8017
JEV_MODEL=jev-latest
JEV_TIMEOUT=1000
# systemone (jevos / Jev) | native | openai-chat
JEV_PROTOCOL=systemone
# Leave empty for the protocol defaults (/v1/systemone + /health for systemone)
JEV_DECIDE_PATH=
JEV_HEALTH_PATH=
# Only if jevos was started with JEV_API_KEY: the lab sends it as a bearer token (never stored in the config)
# JEV_API_KEY=
